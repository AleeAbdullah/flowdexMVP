{
  "extends": ["next/core-web-vitals", "plugin:@typescript-eslint/recommended"],
  "plugins": ["@typescript-eslint", "unused-imports"],
  "rules": {
    // Remove unused imports and variables
    "unused-imports/no-unused-imports": "warn",
    "unused-imports/no-unused-vars": [
      "warn",
      {
        "vars": "all",
        "varsIgnorePattern": "^_|containerClassName|infoTextPosition|infoIconSize|showLabels|roofMeasurementMethod|currentStepTitle|isLast|description|variant|isPending|isLoading|viewportHeight|path|email|setEmail|result",
        "args": "after-used",
        "argsIgnorePattern": "^_|filterKey|onRetry|retryText|router|containerClassName|infoTextPosition|infoIconSize|description|variant|data|error"
      }
    ],
    "@typescript-eslint/no-unused-vars": "off",

    // Import/Export rules
    "import/order": [
      "warn",
      {
        "groups": [
          "builtin",
          "external",
          "internal",
          "parent",
          "sibling",
          "index"
        ],
        "newlines-between": "always",
        "alphabetize": {
          "order": "asc",
          "caseInsensitive": true
        }
      }
    ],
    "import/no-duplicates": "warn",
    "import/named": "off",

    // General best practices
    "no-console": "warn",
    "no-debugger": "warn",
    "no-alert": "warn",
    "no-var": "warn",
    "prefer-const": "warn",
    "prefer-arrow-callback": "warn",
    "prefer-template": "warn",
    "object-shorthand": "warn",
    "no-duplicate-imports": "warn",
    "no-useless-rename": "warn",
    "no-useless-return": "warn",
    "no-unreachable": "warn",
    "no-empty": "off",
    "no-empty-function": "warn",
    "curly": ["warn", "all"],

    // TypeScript specific rules (without type-aware rules)
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-non-null-assertion": "warn",
    "@typescript-eslint/ban-types": "warn",
    "@typescript-eslint/explicit-function-return-type": "off",
    "@typescript-eslint/explicit-module-boundary-types": "off",
    "@typescript-eslint/ban-ts-comment": "warn",
    "@typescript-eslint/no-inferrable-types": "warn",
    "@typescript-eslint/prefer-as-const": "warn",

    // React specific rules (handled by Next.js config)
    "react/self-closing-comp": "warn",
    "react/jsx-fragments": ["warn", "syntax"],
    "react-hooks/rules-of-hooks": "off",
    "react-hooks/exhaustive-deps": "off",
    "react/display-name": "off",
    "react/no-unescaped-entities": "warn",
    "@next/next/no-img-element": "warn"
  }
}
