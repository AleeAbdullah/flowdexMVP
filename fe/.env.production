# BETTER_AUTH_SECRET=
# INTERNAL_AUTH_JWT_SECRET=
# INTERNAL_AUTH_ISSUER=fe-bff
# INTERNAL_AUTH_AUDIENCE=be-api
# ADMIN_EMAILS=

# Error monitoring
# SENTRY_AUTH_TOKEN=

# Logging ingestion
