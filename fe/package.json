    "@t3-oss/env-nextjs": "^0.13.10",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-query-devtools": "^5.91.3",
    "axios": "^1.13.4",
    "better-auth": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "dotted-map": "^3.1.0",
    "framer-motion": "^12.29.2",
    "import-in-the-middle": "^2.0.6",
    "jose": "^6.2.2",
