    "next-themes": "^0.4.6",
    "nuqs": "^2.8.7",
    "pg": "^8.20.0",
    "posthog-js": "^1.336.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.1",
    "require-in-the-middle": "^8.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "three": "^0.184.0",
